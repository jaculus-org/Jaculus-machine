{
    "name": "exports",
    "type": "module",
    "exports": {
        ".": "./index.js",
        "./aliased": "./aliased.js",
        "./nested/*": "./nested/*.js",
        "./extension/*.js": "./extension/*.js",
        "./remapped": "./remapped/index.js",
        "./array": [
            { "browser": "./ignored.js" },
            "../invalid.js",
            "./array.js"
        ],
        "./wildcard/*": "./generic/*.js",
        "./wildcard/features/*": "./specific/*.js",
        "./blocked": null,
        "./integer": {
            "0": "./zero.js",
            "default": "./fallback.js"
        },
        "./invalid-target": "./NODE_MODULES",
        "./invalid-pattern/*": "./dist/*.js",
        "./empty*": "./actual*.js"
    }
}
